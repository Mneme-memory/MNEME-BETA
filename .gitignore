# Mneme - Git Ignore File
# This tells Git which files to never commit to version control

# ============================================================================
# SENSITIVE DATA - NEVER COMMIT THESE
# ============================================================================

# Configuration file with API keys
config.json

# Environment variables (if we add .env later)
.env
.env.local

# ============================================================================
# DATABASE AND DATA FILES
# ============================================================================

# Custom system instructions
system_instructions.txt

# Database file (contains private conversations)
data/
*.db
*.sqlite
*.sqlite3

# Backups (large files, private data)
backups/
*.backup_*

# ============================================================================
# PYTHON
# ============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# PyCharm
.idea/

# VS Code
.vscode/

# Jupyter Notebook
.ipynb_checkpoints

# ============================================================================
# NODE.JS (for Phase 3 web interface)
# ============================================================================

node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# ============================================================================
# OPERATING SYSTEM FILES
# ============================================================================

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ============================================================================
# LOGS AND TEMPORARY FILES
# ============================================================================

*.log
*.tmp
*.temp
logs/
temp/

# Script output files (generated by scripts/)
scripts/*.json
scripts/*.txt

# ============================================================================
# TESTING
# ============================================================================

.pytest_cache/
.coverage
htmlcov/
.tox/

# ============================================================================
# NOTES
# ============================================================================

# Keep config.example.json (template)
!config.example.json

# Keep README and documentation
!README.md
!*.md

# Compiled installer binary (built from scripts/installer/Mneme-Installer.iss)
Mneme-Setup.exe

# Release ZIP (generated by scripts/push-production.sh)
Mneme-release.zip

# Release artifacts (generated, not source — distributed via GitHub Releases)
GIVE-TO-CLAUDE-FOR-HELP.pdf

# Backup files
config-old.json
config*.json.bak

# Temp files
temp_*.txt

# Exports (private conversation extracts)
exports/

# Claude Code config
.claude/

# Working/review files (entity consolidation, etc.)
entity_list.txt
entity_proposals_review.txt
entity_review_all.txt
entity_review_progress.txt

# Internal docs not for public repo
docs/TODO_SOMEDAY.md
docs/archive/
docs/analysis/
docs/reference/
docs/developer/CODEBASE_REVIEW_2026-03-21.md
docs/developer/REFACTOR_OPPORTUNITIES.md

# Single-use scripts (migrations, backfills, one-off fixes, abandoned features)
scripts/internal/

# Prototypes
Loading animation/

# Playwright MCP screenshots
.playwright-mcp/

# Internal planning/design docs
docs/INFOGRAPHIC_ARCHITECTURE.txt
docs/developer/DEMO_PLAN.md
docs/video_plan.md
docs/emma.md
docs/demo_script.md

# Static demo (deployed separately to website, not part of the repo)
demo/
